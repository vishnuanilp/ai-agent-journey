---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	classify(classify)
	research(research)
	respond(respond)
	extract(extract)
	ask(ask)
	approve(approve)
	book(book)
	cancel(cancel)
	chat(chat)
	error_box(error_box)
	remember(remember)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> classify;
	__start__ -.-> extract;
	approve -.-> book;
	approve -.-> cancel;
	ask --> remember;
	book --> remember;
	cancel --> remember;
	chat --> remember;
	classify -. &nbsp;chitchat&nbsp; .-> chat;
	classify -. &nbsp;error&nbsp; .-> error_box;
	classify -. &nbsp;action&nbsp; .-> extract;
	classify -. &nbsp;question&nbsp; .-> research;
	error_box --> remember;
	extract -.-> approve;
	extract -.-> ask;
	extract -.-> cancel;
	extract -.-> classify;
	research --> respond;
	respond --> remember;
	remember --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
